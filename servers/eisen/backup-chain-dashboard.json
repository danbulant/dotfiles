{
  "annotations": {
    "list": []
  },
  "description": "Backup-chain health for Eisen's local restic jobs and Fern's Eisen-to-Hetzner transfer. This dashboard consumes only the backup_job_* textfile contract metrics. Missing series are explicitly unknown and never treated as healthy.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "**Freshness:** age of the last successful run; limits are 16h for Forgejo and Matrix (including the scheduled 21:00–09:00 gap), 8h for Fern → Hetzner, and 36h for daily jobs. Check the latest-result table too: a recent success does not hide a later failure. Unknown is not healthy; Fern may sleep.\n\n**Forgejo:** live incremental SQLite + Git mirrors + file capture. No backup outage; database, repositories and attachments are not an atomic application-wide snapshot. Retention on each destination: 24 hourly / 14 daily / 8 weekly / 12 monthly / 5 yearly buckets per app; this is not a disk-size cap.",
        "mode": "markdown"
      },
      "pluginVersion": "11.0.0",
      "type": "text",
      "title": "Backup-chain contract and freshness"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "cewzter06us5cf"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "UNKNOWN — no telemetry",
          "mappings": [{"type": "special", "options": {"match": "null+nan", "result": {"text": "UNKNOWN — no successful run", "color": "gray"}}}],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 57600
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "time() - backup_job_last_success_timestamp_seconds{host=~\"${host:regex}\",backup=\"forgejo\"}",
