
{{ $url := .Options.StringOr "url" "" }}
{{ $key := .Options.StringOr "key" "" }}

{{- if or (eq $url "") (eq $key "") -}}

    <p>Error: The URL or API Key was not configured in the widget options.</p>

{{- else -}}

    {{- $request := newRequest (printf "%s/Items/Counts" $url)
        | withHeader "Authorization" (printf "MediaBrowser Token=\"%s\"" $key)
        | withHeader "Accept" "application/json"
        | getResponse -}}

    {{- if eq $request.Response.StatusCode 200 -}}
    <div class="flex flex-column gap-5">
        <div class="flex justify-between text-center">

        <div>
            <div class="color-highlight size-h3">{{ $request.JSON.Int "MovieCount" | formatNumber }}</div>
            <div class="size-h5 uppercase">Movies</div>
        </div>

        <div>
            <div class="color-highlight size-h3">{{ $request.JSON.Int "SeriesCount" | formatNumber }}</div>
            <div class="size-h5 uppercase">TV Shows</div>
        </div>

        <div>
            <div class="color-highlight size-h3">{{ $request.JSON.Int "EpisodeCount" | formatNumber }}</div>
            <div class="size-h5 uppercase">Episodes</div>
        </div>

        <div>
            <div class="color-highlight size-h3">{{ $request.JSON.Int "SongCount" | formatNumber }}</div>
            <div class="size-h5 uppercase">Songs</div>
        </div>

        </div>
    </div>
    {{- else -}}
    <p>Failed: {{ $request.Response.Status }}</p>
    {{- end -}}
{{- end -}}
