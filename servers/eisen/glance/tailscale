{{ if ne .Response.StatusCode 200 }}
<p class="color-negative">Tailscale status unavailable (HTTP {{ .Response.StatusCode }}).</p>
{{ else if eq (len (.JSON.Array "devices")) 0 }}
<p>No Tailscale devices found.</p>
{{ else }}
<ul class="list list-gap-10 collapsible-container" data-collapse-after="{{ .Options.IntOr "collapseAfter" 3 }}">
    {{ range .JSON.Array "devices" }}
    <li>
        <div class="flex items-center gap-10">
            <span class="size-h4 block text-truncate color-primary grow">{{ .String "name" }}</span>
            {{ if .Bool "online" }}
            <span class="color-positive size-h5">Online</span>
            {{ else }}
            <span class="color-negative size-h5">Offline</span>
            {{ end }}
        </div>
        <ul class="list-horizontal-text">
            <li>{{ .String "os" }}</li>
            <li>{{ .String "addresses.0" }}</li>
        </ul>
    </li>
    {{ end }}
</ul>
{{ end }}
